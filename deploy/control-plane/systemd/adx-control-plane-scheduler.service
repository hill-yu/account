[Unit]
Description=ADX control-plane scheduler
After=network.target adx-control-plane.service
Requires=adx-control-plane.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/adx-account-isolated-collector/backend
EnvironmentFile=/srv/adx-account-isolated-collector/backend/.env
ExecStartPre=/srv/adx-account-isolated-collector/backend/.venv/bin/alembic upgrade head
ExecStart=/srv/adx-account-isolated-collector/backend/.venv/bin/python -m app.scheduler_main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
